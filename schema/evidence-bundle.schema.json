{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cra-ready-toolkit/evidence-bundle.schema.json",
  "title": "CRA evidence bundle manifest",
  "description": "Manifest of one release evidence bundle: SBOM + vulnerability scan + KEV gate result, with provenance. SPEC.md §4.",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "pipeline",
    "generated_at",
    "tools",
    "inputs",
    "results",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "product": {
      "type": "object",
      "required": ["name", "version", "commit_sha"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "minLength": 1 },
        "support_period_end": {
          "type": ["string", "null"],
          "description": "Optional declared support period end (ISO date), recorded verbatim from the component input."
        }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["url", "job_id", "runner"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "job_id": { "type": "string", "minLength": 1 },
        "runner": { "type": "string", "minLength": 1 }
      }
    },
    "generated_at": {
      "type": "string",
      "description": "RFC3339 UTC timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "tools": {
      "type": "object",
      "required": ["syft", "grype", "cosign"],
      "additionalProperties": false,
      "properties": {
        "syft": { "type": "string", "minLength": 1 },
        "grype": { "type": "string", "minLength": 1 },
        "cosign": {
          "type": ["string", "null"],
          "description": "null when the signing step did not run (e.g. local demo without cosign installed)"
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["image_ref", "kev_catalog_date"],
      "additionalProperties": false,
      "properties": {
        "image_ref": { "type": "string", "minLength": 1 },
        "kev_catalog_date": { "type": "string", "minLength": 1 }
      }
    },
    "results": {
      "type": "object",
      "required": ["component_count", "vuln_counts_by_severity", "kev_gate"],
      "additionalProperties": false,
      "properties": {
        "component_count": { "type": "integer", "minimum": 0 },
        "vuln_counts_by_severity": {
          "type": "object",
          "description": "Severity name -> finding count, as reported by the scanner",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "kev_gate": { "enum": ["pass", "fail"] }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
